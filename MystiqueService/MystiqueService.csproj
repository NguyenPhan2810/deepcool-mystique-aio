<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Exe, never WinExe: a Windows service must be a console-subsystem executable.
         TargetFramework deliberately omitted; Directory.Build.props supplies
         net10.0-windows and a value here would win. -->
    <OutputType>Exe</OutputType>
    <RootNamespace>MystiqueService</RootNamespace>
    <AssemblyName>MystiqueService</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mystique.Core.Contracts\Mystique.Core.Contracts.csproj" />
    <ProjectReference Include="..\Mystique.Core.Device\Mystique.Core.Device.csproj" />
  </ItemGroup>

</Project>
