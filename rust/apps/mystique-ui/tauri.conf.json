{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MYSTIQUE Control",
  "version": "0.1.0",
  "identifier": "org.nguyenphan.mystique-ui",
  "build": {
    "frontendDist": "ui",
    "beforeBuildCommand": {
      "script": "pwsh -NoProfile -ExecutionPolicy Bypass -File prepare-daemon.ps1",
      "cwd": "installer"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MYSTIQUE LCD Control",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "visible": false,
        "theme": "Dark",
        "backgroundColor": "#0f1419"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "installer/stage": "daemon"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "installer/hooks.nsh"
      }
    }
  }
}
