{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MYSTIQUE Control",
  "version": "0.1.0",
  "identifier": "org.nguyenphan.mystique-ui",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MYSTIQUE LCD Control",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
