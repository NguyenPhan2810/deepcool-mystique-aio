[Unit]
Description=DeepCool MYSTIQUE LCD daemon (telemetry stream and control socket)
Documentation=file:///%h/.local/share/doc/mystique/README.md
# User unit, not a system unit: the panel is a display, and access is granted to the
# logged-in user by packaging/linux/99-deepcool-mystique.rules. That rule matches the
# device by vendor/product id (3633:0009), not by bus path, so it must be installed in
# /etc/udev/rules.d/ and followed by one replug. Nothing here needs root.
#
# systemd has no stable unit name for a USB panel whose bus path changes with the port.
# The daemon is therefore started after the session/udev and retries on its own until
# the panel enumerates; a missing or unplugged device never exits it.
After=graphical-session.target systemd-udevd.service
PartOf=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
# Install the binary at ~/.local/bin/mystique-daemon, or change this path.
ExecStart=%h/.local/bin/mystique-daemon
# The single-instance lock is released with the process and the worker retries on any
# transient USB fault, so a restart never fights a stale owner.
Restart=on-failure
RestartSec=2s
# The daemon stops the stream, writes brightness 0, releases the handle and removes
# the socket on SIGTERM. Give it time to finish a slow USB write.
KillSignal=SIGTERM
TimeoutStopSec=10s

[Install]
WantedBy=default.target
