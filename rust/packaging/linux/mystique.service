[Unit]
Description=DeepCool MYSTIQUE LCD telemetry
Documentation=file:///%h/.local/share/doc/mystique/README.md
# A user unit, not a system unit: the panel is a display, and the udev rule grants
# the logged-in user access. Nothing here needs root.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# Install the binary at ~/.local/bin/mystique, or change this path.
ExecStart=%h/.local/bin/mystique live
# The device is single-owner. Never run a second instance while the panel is busy;
# the second open fails with access-denied, which would put this unit in a restart
# loop. RestartSec is deliberately longer than the USB re-enumeration delay.
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
