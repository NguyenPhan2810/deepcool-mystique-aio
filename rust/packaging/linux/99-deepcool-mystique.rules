# DeepCool MYSTIQUE AIO LCD — 3633:0009
#
# The device is USB class 0xFF (vendor-specific) with four bulk endpoints:
#   OUT 0x01 / IN 0x81   init + device info
#   OUT 0x02 / IN 0x82   status + telemetry
#
# It binds to usbfs, not hidraw and not a serial driver. No kernel module is needed.
#
# TAG+="uaccess" grants the user on the active seat an ACL on the device node.
# GROUP="plugdev" is the fallback for a headless service account. MODE 0660 keeps
# the node non-world-writable.
#
# Install:
#   sudo install -m 0644 99-deepcool-mystique.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger --subsystem-match=usb --attr-match=idVendor=3633
# then unplug and replug the panel once.

SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="3633", ATTR{idProduct}=="0009", TAG+="uaccess", GROUP="plugdev", MODE="0660"
